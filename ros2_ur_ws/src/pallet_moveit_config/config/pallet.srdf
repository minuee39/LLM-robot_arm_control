<?xml version="1.0"?>
<robot name="pallet">
  <virtual_joint name="world_joint" type="fixed" parent_frame="world" child_link="base_footprint"/>
  <group name="pallet_arm"><chain base_link="base_link" tip_link="gripper"/></group>
  <group name="gripper"><joint name="g_r"/></group>
  <end_effector name="pallet_gripper" parent_link="gripper" group="gripper"/>
  <group_state name="home" group="pallet_arm">
    <joint name="J1" value="0"/><joint name="J2" value="0"/><joint name="J3" value="0"/>
    <joint name="J4" value="0"/><joint name="J5" value="0"/><joint name="J6" value="0"/>
  </group_state>
  <group_state name="open" group="gripper"><joint name="g_r" value="0"/></group_state>
  <group_state name="closed" group="gripper"><joint name="g_r" value="-0.103"/></group_state>
</robot>
