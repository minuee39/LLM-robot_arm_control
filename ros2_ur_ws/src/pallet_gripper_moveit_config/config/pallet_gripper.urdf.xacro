<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="pallet_gripper">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import pallet_gripper urdf file -->
    <xacro:include filename="$(find pallet_gripper)/urdf/pallet_gripper.urdf" />

    <!-- Import control_xacro -->
    <xacro:include filename="pallet_gripper.ros2_control.xacro" />


    <xacro:pallet_gripper_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
